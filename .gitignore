# Reveal — .gitignore

# Dados de clientes (NUNCA commitar dados reais de tickets)
tickets/*/
!tickets/_template/
!tickets/INDEX.md

# Configuração local (cópia de refine-config.json com dados reais)
refine-config.local.json
*.local.*

# Anexos binarios de tickets (NUNCA commitar)
tickets/*/attachments/

# Python cache
__pycache__/
*.pyc

# Temporários
tmp/
*.tmp

# Credenciais (~/.jira-credentials fica no home, não no repo)
.jira-credentials
**/credentials*
**/secrets*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Gerado pelo agente IA, nao faz parte do projeto
.codebase.md

# Dados temporarios de execucao do pipeline
jira-data.json
jira-summary.md
attachments/

# Backups
*.bak
